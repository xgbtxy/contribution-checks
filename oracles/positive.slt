# The sort key is a renamed direct aggregate output; computed siblings and reordered outputs are unrelated.
statement ok
CREATE TABLE t AS SELECT column1 AS g, column2 AS v FROM (VALUES ('a', 2), ('b', 10), ('c', 9), ('d', 3), ('e', 7));

statement ok
SET datafusion.optimizer.enable_topk_aggregation = true;

query ITI
SELECT score AS rank, g AS label, -score AS decoration FROM (SELECT g, MAX(v) AS score FROM t GROUP BY g) ORDER BY 1 DESC LIMIT 2;
----
10 b -10
9 c -9
