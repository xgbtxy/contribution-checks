+struct LegacyCommonPrefixBlock {
+  const char* name;
+  const char* bytes;
+  size_t size;
+  uint32_t restart_interval;
+  std::vector<std::pair<std::string, std::string>> entries;
+  std::vector<std::string> seek_targets;
+};
